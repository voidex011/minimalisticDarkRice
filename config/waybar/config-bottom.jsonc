{
    "layer": "bottom",
    "position": "bottom",
    "height": 30,
    "margin-bottom": 10,
    "margin-left": 15,
    "margin-right": 15,
    "margin-top": 0,

    
    "modules-center": [
        "custom/firefox", 
        "custom/chromium", 
        "custom/terminal", 
        "custom/files",
        "custom/steam"
    ],

    "custom/firefox": {
        "format": "",
        "on-click": "firefox",
        "tooltip-format": "Firefox"
    },

    "custom/chromium": {
        "format": "", 
        "on-click": "chromium", 
        "tooltip-format": "Chromium"
    },

    "custom/terminal": {
        "format": "", 
        "on-click": "alacritty",
        "tooltip-format": "terminal"
    },

    "custom/files": {
        "format": "", 
        "on-click": "nautilus",
        "tooltip-format": "files"
    },

    "custom/steam": {
        "format": "◎",
        "on-click": "steam",
        "tooltip-format": "Steam"
    }
}
