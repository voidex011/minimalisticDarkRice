
{

    "layer": "bottom",
    "mod": "dock",
    "margin-top": 10,
    "margin-bottom": 0,
    "margin-left": 15,
    "margin-right": 15,

    "position": "top",
    
    "height": 30,
    
    "opacity": 1.0,
    
    "modules-left": ["niri/workspaces", "hyprland/window"],
    
    "modules-center": ["clock"],
    
    "modules-right": ["custom/youtube","niri/language","pulseaudio","custom/power"],
    

    // workspaces
    "niri/workspaces": {
        "format": "{index}", // Отображает цифры (1, 2, 3...) вместо имени
    },

    // clock
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y %H:%M}",
    },

    "niri/language":{
       "format": "  {}",
        "min-length": 5,
        "format-en": "EN",
        "format-ru": "RU"
    },

    // volume
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "{volume}% {icon} ",
        "format-muted": "🔇",
        "format-icons": {
            "default": ["", "", ""]
        },
    },
    
    // network
    "network": {
        "format": "{ifname}",
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤮  Отключено",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    
    // battery
    "battery": {
        "format": "{capacity}% {icon}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-charging": "󰂄 {capacity}%"
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    },
}
